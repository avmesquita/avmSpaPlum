@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.Email>

@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão de e-mails enviados</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Enviar novo e-mail" })
</div>
<div class="container">
	<table id="tabela-emails" class="table table-hover">
		<thead>
			<tr>
				<th></th>
				<th>
					De
				</th>
				<th>
					Para
				</th>
				<th>
					Assunto
				</th>
				<th>
					Mensagem
				</th>
				<th>
					Data Envio
				</th>
				<th>
					Houve Falha?
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Details", new { id = item.CodigoEmail }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })

						@if (HttpContext.Current.User.Identity.Name != "")
						{
							if (HttpContext.Current.User.Identity.Name.Equals("andre@avmsistemas.net"))
							{
								@Html.ActionLink(" ", "Delete", new { id = item.CodigoEmail }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
							}
						}
					</td>
					<td>
						@Html.Raw(item.DoNome)
					</td>
					<td>
						@Html.Raw(item.ParaNome)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Assunto)
					</td>
					<td style="zoom:50%">
						@Html.Raw(item.Mensagem)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.DataEnvio)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.HouveFalha)
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
