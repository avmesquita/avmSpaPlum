@model SpaPlum.Web.Entity.StatusAgendamento

@{
    ViewBag.Title = "Exclusão de Status de Agendamento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h2>Corpus SPA</h2>

<div style="float:right;width:150px;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:30px;" })
</div>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Detalhes do Status do Agendamento</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Descricao)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Descricao)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Excluir" class="btn btn-default btn-primary btn-danger" />
            <br /><br /><br /><br />
            @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar" })
        </div>
    }
</div>
