@model IEnumerable<SpaPlum.Web.Entity.StatusAgendamento>

@{
    ViewBag.Title = "Listagem de Status de Agendamento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h4 style="text-decoration:underline;">Gestão de Filiais</h4>
<br />
<div style="float:right;width:150px;padding-bottom:10px;">
    @Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Cadastrar Novo Status de Agendamento" })
</div>
<div class="container">
    <table id="tabela-status-agendamento" class="table table-hover">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Descricao)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.ActionLink(" ", "Edit", new { id = item.CodigoStatusAgendamento }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })
                        @Html.ActionLink(" ", "Details", new { id = item.CodigoStatusAgendamento }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })
                        @Html.ActionLink(" ", "Delete", new { id = item.CodigoStatusAgendamento }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>