    <script language="JavaScript" type="text/javascript">
        var sourcevar = getQueryVariable("utm_source");
        var apclickvar = getQueryVariable("apclick");
        var apsourcevar = getQueryVariable("apsource");
        function getQueryVariable(variable) {
            var query = window.location.search.substring(1);
            var vars = query.split("&");
            for (var i=0;i<vars.length;i++) {
                var pair = vars[i].split("=");
                if (pair[0] == variable) {
                    return pair[1];
                } } }
        function setCookie(cname, cvalue, exdays) {
            var d = new Date();
            d.setTime(d.getTime() + (exdays*24*60*60*1000));
            var expires = "expires=" + d.toUTCString();
            document.cookie = cname + "=" + cvalue + "; path=/;" + expires + "; domain=cantao.com.br";
            return cookieap;
        }
        if (sourcevar == "actionpay") {
            var cookieap = setCookie("actionpay",apclickvar+"."+apsourcevar,30);
            var cookieap = setCookie("Origem","actionpay",30);
        }else if ( sourcevar != undefined) {
            var cookieap = setCookie("Origem", sourcevar ,30);;
        }

        (function() {
            var s = document.createElement('script');
            s.type = 'text/javascript';
            s.async = s.defer = true;
            s.src = '//aprtx.com/code/cantao/';
            var p = document.getElementsByTagName('body')[0] || document.getElementsByTagName('head')[0];
            if (p) p.appendChild(s);
        })();
    </script>
