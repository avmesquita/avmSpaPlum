    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');
        
        ga('create', 'UA-5641649-2', 'auto');
        @{           
            #region UserID            
            string userIdCodigoInjectado = "";            
            var usuarioLogado = HttpContext.Current.User.Identity;
            if (usuarioLogado != null)
            {                
                string userID = usuarioLogado.Name.ToString();
                userIdCodigoInjectado = string.Format("ga(\'set\',\'&uid', \'{0}\')", userID); 
            }
            System.Web.HtmlString UserIDtexto = new HtmlString(userIdCodigoInjectado);
            #endregion
        }                   

        @Html.Raw(userIdCodigoInjectado);
        ga('send', 'pageview');
    </script>
