@model SpaPlum.Web.Entity.TerapeutaServico

@{
    ViewBag.Title = "Exclusão de Serviço por Profissional";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:10px;" })
</div>

<div class="col-md-8">
    <h3 style="color:red;text-align:center;"><b>Tem certeza que deseja excluir?</b></h3>
    <br /><br />
          <div>
              <h4 style="text-decoration:underline;">Serviço prestado pelo Profissional</h4>
              <hr />
              <dl class="dl-horizontal">
                  <dt style="font-size:16px;line-height:30px;">
                      Profissional
                  </dt>

                  <dd style="font-size:16px;line-height:30px;">
                      @Html.DisplayFor(model => model.Terapeuta.Nome)
                  </dd>

                  <dt style="font-size:16px;line-height:30px;">
                      Serviço
                  </dt>

                  <dd style="font-size:16px;line-height:30px;">
                      @Html.DisplayFor(model => model.Servico.Nome)
                  </dd>
              </dl>

              @using (Html.BeginForm())
    {
          @Html.AntiForgeryToken()

          <div class="form-actions no-color" style="padding-top:30px;text-align:center;">
              <input type="submit" value="Excluir" class="btn btn-default btn-primary btn-danger" />&nbsp;&nbsp;@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-info", title = "Voltar" })
          </div>
}
          </div>
</div>