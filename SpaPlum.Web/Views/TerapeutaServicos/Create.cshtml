            $('#CodigoFilial').change(function () {
                $.ajax({
                    url: '/Agendamento/TerapeutasPorFilial',
                    type: 'POST',
                    data: { codigoFilial: $(this).val() },
                    datatype: 'json',
                    success: function (data) {
                        var options = '';
						if (data) {
							options += '<option value="-1">Selecione o(a) profissional</option>';
                            $.each(data, function () {
                                options += '<option value="' + this.CodigoTerapeuta + '">' + this.Nome + '</option>';
                            });
                            $('#CodigoTerapeuta').prop('disabled', false).html(options);
						} else {
							var options = '';
							options += '<option value="-1">Não existem terapeutas cadastradas.</option>';
							$('#CodigoTerapeuta').prop('disabled', true).html(options);
                        }
                    }
				});
