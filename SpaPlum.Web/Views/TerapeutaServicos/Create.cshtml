                });*/
			});
			$('#CodigoTerapeuta').change(function () {
				$.ajax({
					url: '/Agendamento/ObterServicosDaFilialDaTerapeuta',
					type: 'POST',
					data: { codigoFilial: $("#CodigoFilial").val(), codigoTerapeuta: $(this).val() },
					datatype: 'json',
					success: function (data) {
						var options = '';
						if (data) {
							$.each(data, function () {
								options += '<option value="' + this.CodigoServico + '">' + this.Nome + '</option>';
							});
							$('#ServicosIds').prop('disabled', false).html(options);
						} else {
							var options = '';
							options += '<option value="-1">Não existem serviços cadastrados.</option>';
							$('#ServicosIds').prop('disabled', true).html(options);
						}
					}
				});
			});
        });
        </script>
