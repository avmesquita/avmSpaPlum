@model SpaPlum.Web.Entity.TerapeutaServico

@{
    ViewBag.Title = "GHP - Seleção de Habilidades Profissionais";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h4 style="text-decoration:underline;">GHP - Seleção de Habilidades Profissionais</h4>

<div class="col-md-8">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
            <h5>Selecione o(a) Profissional e suas Habilidades</h5>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group">
                @Html.Label("Filial", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("CodigoFilial", new SelectList(ViewBag.ListaFilial, "Value", "Text"), "Selecione a Filial...", new { htmlAttributes = new { @class = "form-control" }, style = "width:400px;height:33px;" })
                    @Html.ValidationMessageFor(model => model.CodigoTerapeuta, "", new { @class = "text-danger" })
                </div>
            </div>


            <div class="form-group">
                @Html.Label("Profissional", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("CodigoTerapeuta", Enumerable.Empty<SelectListItem>(), "Selecione a Terapeuta...", new { htmlAttributes = new { @class = "form-control" }, style = "width:400px;height:33px;", @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.CodigoTerapeuta, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Selecione as Habilidades", new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.ListBoxFor(i => i.ServicosIds, Model.ServicosSelecionados,
                                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(i => i.CodigoServico,
                                        "", new { @class = "text-warning" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Gravar" class="btn btn-default btn-primary" />&nbsp;&nbsp;&nbsp;&nbsp;@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-error", title = "Voltar" })

                </div>
            </div>
        </div>
    }
</div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        @Scripts.Render("~/bundles/bootstrap")

