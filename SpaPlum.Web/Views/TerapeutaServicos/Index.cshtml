@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.TerapeutaServico>

@{
	ViewBag.Title = "GHP - Gestão de Habilidades Profissionais";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">GHP - Gestão de Habilidades Profissionais</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Incluir nova habilidade do serviço à Profissional" })
</div>
<div class="container">
	<table id="tabela-servicos-terapeutas" class="table table-hover">
		<thead>
			<tr>
				<th></th>
				<th>Profissional</th>
				<th>Serviço</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Delete", new { id = item.CodigoTerapeutaServico }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Terapeuta.Nome) [@Html.DisplayFor(modelItem => item.Terapeuta.Filial.Nome)]
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Servico.Nome)
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
