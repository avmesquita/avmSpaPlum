@model IEnumerable<SpaPlum.Web.Entity.HorarioTerapeuta>

<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@*Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success glyphicon glyphicon-plus-sign", title = "Cadastrar Novo Horário de Atendimento" })*@
	@Html.ActionLink(" ", "Create", "HorarioTerapeuta", "http", "localhost", "conteudo", new { CodigoTerapeuta = ViewBag.CodigoTerapeuta }, new { @class = "btn btn-primary btn-large btn-success glyphicon glyphicon-plus-sign", title = "Cadastrar Novo Horário de Atendimento" })
</div>
<div class="col-md-12">
	@if (Model.Count() > 0)
	{
		<table id="tabela-horario-atendimento" class="table">
			<thead>
				<tr>
					<th></th>
					<th>
						@Html.DisplayNameFor(model => model.CodigoDiaDaSemana)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.HorarioInicio)
					</th>
					<th>
						@Html.DisplayNameFor(model => model.HorarioFim)
					</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in Model)
				{
					<tr>
						<td>
							@*@Html.ActionLink(" ", "Edit", "HorarioTerapeuta", "http", "localhost", "conteudo", new { id = item.CodigoHorarioTerapeuta, CodigoTerapeuta = item.CodigoTerapeuta }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })*@
							@*@Html.ActionLink(" ", "Details", "HorarioTerapeuta", "http", "localhost", "conteudo", new { id = item.CodigoHorarioTerapeuta, CodigoTerapeuta = item.CodigoTerapeuta }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })*@
							@Html.ActionLink(" ", "Delete", "HorarioTerapeuta", "http", "localhost", "conteudo", new { id = item.CodigoHorarioTerapeuta, CodigoTerapeuta = item.CodigoTerapeuta }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
						</td>
						<td>
							@Enum.GetName(typeof(SpaPlum.Web.Entity.DiaDaSemana), item.CodigoDiaDaSemana)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.HorarioInicio)
						</td>
						<td>
							@Html.DisplayFor(modelItem => item.HorarioFim)
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
	else
	{
		<br />
		<br />
		<table>
			<tr>
				<th>Não existem horários cadastrados.</th>
			</tr>
			<tr>
				<td>Clique no botão Novo para criar horários.</td>
			</tr>
		</table>


	}
</div>
<script type="text/javascript">
	$(document).ready(function () {
		$('#tabela-horario-atendimento').DataTable({
			"language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Portuguese-Brasil.json" }
		});
	});
</script>
