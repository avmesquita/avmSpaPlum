    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Processando Paypal</h2>

<br><br>
<div class="list-header clearfix">
    <h2>Opa! Era para você ter sido redirecionado.</h2>
    <h3>Alguma coisa não saiu como planejado.</h3>
    <h4>Mas é sempre assim, né?!</h4>
