@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.Fornecedor>

@{
	ViewBag.Title = "Listagem de Fornecedores";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão de Fornecedores</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Cadastrar Novo Fornecedor" })
</div>
<div class="container">
	<table id="tabela-fornecedores" class="table table-hover">
		<thead>
			<tr>
				<th></th>
				<th>Filial</th>
				<th>Nome</th>
				<th>Fornece o que?</th>
				<th>Ativo</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Edit", new { id = item.CodigoFornecedor }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })
						@Html.ActionLink(" ", "Details", new { id = item.CodigoFornecedor }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })
						@Html.ActionLink(" ", "Delete", new { id = item.CodigoFornecedor }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Filial.Nome)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Nome)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.ForneceOque)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Ativo)
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>
