@model SpaPlum.Web.Entity.Fornecedor

@{
    ViewBag.Title = "Exclusão de Fornecedor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:30px;" })
</div>

<div class="col-md-8">
    <h3 style="color:red;text-align:center;"><b>Tem certeza que deseja excluir?</b></h3>
    <div style="padding-top:30px;">
        <h5> Não seria melhor alterar para INATIVO?</h5>
        <div>
            <h4 style="text-decoration:underline;">Detalhes do Fornecedor</h4>
            <hr />
            <dl class="dl-horizontal">
                <dt style="font-size:16px;line-height:30px;">
                    @Html.DisplayNameFor(model => model.Filial.Nome)
                </dt>

                <dd style="font-size:16px;line-height:30px;">
                    @Html.DisplayFor(model => model.Filial.Nome)
                </dd>

                <dt style="font-size:16px;line-height:30px;">
                    @Html.DisplayNameFor(model => model.Nome)
                </dt>

                <dd style="font-size:16px;line-height:30px;">
