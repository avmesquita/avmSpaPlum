@model IEnumerable<SpaPlum.Web.Models.MyTaskModel>

@{
    ViewBag.Title = "Tarefas";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/datatables")
    @Styles.Render("~/Content/datatables")

    <script type="text/javascript">
        $(document).ready(function () {

            $('#tabela-minhas-tarefas').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Portuguese-Brasil.json" }
            });

        });
    </script>
}

<h2>Minhas Tarefas</h2>

<p>
    @Html.ActionLink("Nova Tarefa", "Create")
</p>
<table id="tabela-minhas-tarefas" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.ActionLink("Alterar", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Excluir", "Delete", new { id = item.Id }) |
                @Html.ActionLink("Detalhes", "Details", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>