@model SpaPlum.Web.Entity.Filial

@{
    ViewBag.Title = "Exclusão de Filial";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:30px;" })
</div>

<div class="col-md-8">
    <h3 style="color:red;text-align:center;font-family:fantasy;padding-top:20px;"><b>Tem certeza que deseja excluir?</b></h3>
	<div style="padding-top:30px;">		
		<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Detalhes da Filial</h4>
		<hr />
		<dl class="dl-horizontal">
			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.Nome)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.Nome)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.Ativo)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.Ativo)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.EmailPrincipalFilial)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.EmailPrincipalFilial)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.EmailSecundarioFilial)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.EmailSecundarioFilial)
			</dd>


		</dl>

		@using (Html.BeginForm())
		{
			@Html.AntiForgeryToken()

			<div class="form-actions no-color" style="padding-top:30px;text-align:center;">
				<input type="submit" value="Excluir" class="btn btn-default btn-primary btn-danger" />&nbsp;&nbsp;@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-info", title = "Voltar" })
			</div>
		}
	</div>
</div>