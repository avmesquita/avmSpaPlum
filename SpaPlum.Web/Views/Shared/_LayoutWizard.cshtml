</head>
<body>
    <div class="col-md-10" style="position:fixed;top:0;margin-left:0;width:100%;background-color:#2c3e68;color:#fff;height:50px;" id="btnFooter">
        <span style="font-size:10px;color:#fff;float:left;margin-top:-5px;margin-left:0px;">
            @Html.ActionLink("Corpus Spa", "Wizard", "Agendamento", new { area = "" }, new { @class = "navbar-brand", style = "color:#fff;" })
        </span>
        <span style="font-size:10px;color:#ffa000;float:left;margin-top:32px;margin-left:-90px;">W I Z A R D</span>
    </div>
    <div class="container body-content">
        @RenderBody()
    </div>
    <div class="col-md-10" style="position:fixed;bottom:0;margin-left:0;width:100%;background-color:#2c3e68;color:#fff;height:40px;" id="btnFooter">
        <span style="font-size:12px;color:#ffffff;float:left;margin-top:12px;"><a href="http://www.avmsistemas.net">AVM Sistemas</a></span>
    </div>
    @Scripts.Render("~/bundles/jquerymaskedinput")
    @Styles.Render("~/Content/jqueryui")

    @RenderSection("scripts", required: false)
    <script type="javascript">
                $(document).ready(function ()
        {
            Globalize.culture("pt-BR");
        });
    </script>

</body>
</html>



