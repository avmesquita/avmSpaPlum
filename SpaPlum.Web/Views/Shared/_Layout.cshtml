<!DOCTYPE html public lang="pt-br">
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1" />
    <title>Corpus SPA - @ViewBag.Title</title>
    <meta name="description" content="Central de Agendamento Corpus SPA" />
    <meta name="keywords" content="massagem, niterói, rio de janeiro, rj, nikiti, spa, agendamento, terapia, terapeuta, massoterapia, massoterapeuta, corpuspa">
    <meta name="robots" content="index,nofollow">
    <meta http-equiv="content-language" content="pt-br">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/moment")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://use.fontawesome.com/c23528279d.js"></script>
    <script type='application/ld+json'>
        {
        "@@context": "http://www.schema.org",
        "@@type": "LocalBusiness",
        "name": "Spa Plum",
        "url": "https://www.spaplum.com.br",
        "logo": "https://www.spaplum.com.br/spaplum-logo.png",
        "contactPoint": {
        "@@type": "ContactPoint",
        "telephone": "(21) 3587-2011",
        "telephone": "(21) 9-8641-5221"
        "email": "contato@spaplum.com.br",
        },
        "sameAs": ["https://www.spaplum.com.br",
        "https://www.facebook.com/spaplum/",
        "https://www.instagram.com/spaplum/",
        "https://www.pinterest.com/spaplum"],
        "openingHours": "Mo, Tu, We, Th, Fr 09:00-21:00"
        }
    </script>
    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
                m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-00000000-0', 'auto');
        ga('send', 'pageview');
    </script>
</head>
<body>


    <header>
        <div class="navbar navbar-inverse navbar-fixed-top">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <span style="font-size:10px;color:#fff;float:left;margin-top:-5px;margin-left:0px;">
                        @Html.ActionLink("SpaPlum", "Index", "Home", new { area = "" }, new { @class = "navbar-brand", style = "color:#fff;" })
                    </span>
                    <span style="font-size:10px;color:#ffa000;float:left;margin-top:32px;margin-left:-80px;">Corpus SPA</span>
                </div>
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                        <li>&nbsp;</li>
                        @if (HttpContext.Current.User.Identity.IsAuthenticated)
                        {
                            if (HttpContext.Current.User.Identity.Name.Equals("andre@avmsistemas.net") ||
                                 HttpContext.Current.User.Identity.Name.Equals("corpusparj@gmail.com") ||
                                 HttpContext.Current.User.Identity.Name.Equals("corpuspa@hotmail.com"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Gestão Geral <span class="caret"></span></a>
									<ul class="dropdown-menu" role="menu">
										<li>@Html.ActionLink("Gestão de Filiais", "Index", "Filial", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Clientes", "Index", "Cliente", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Formas de Pgto", "Index", "TipoPagamento", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Serviços", "Index", "Servico", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Profisionais", "Index", "Terapeuta", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Horário de Atendimento", "Index", "HorarioTerapeuta", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Habilidades Profissionais", "Index", "TerapeutaServicos", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Promoções", "Index", "Promocao", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Clientes/Promoções", "Index", "PromocaoClientes", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Fornecedores", "Index", "Fornecedor", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de Finanças", "Index", "Lancamento", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão de E-Mails enviados", "Index", "Email", new { area = "" }, null)</li>
										<li>@Html.ActionLink("Gestão do Ponto", "Index", "PontoTerapeuta", new { area = "" }, null)</li>
									</ul>
                                </li>
                            }

                            <li>@Html.ActionLink("Agendamentos", "Index", "Agendamento", new { area = "" }, null)</li>
                            <li>@Html.ActionLink("AGENDA", "Index", "Calendario", new { area = "" }, null)</li>

                            if (HttpContext.Current.User.Identity.Name.Equals("andre@avmsistemas.net") ||
                                 HttpContext.Current.User.Identity.Name.Equals("corpusparj@gmail.com") ||
                                 HttpContext.Current.User.Identity.Name.Equals("corpuspa@hotmail.com"))
                            {
                                <li class="dropdown">
                                    <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Relatórios <span class="caret"></span></a>
                                    <ul class="dropdown-menu" role="menu">
                                        <li>@Html.ActionLink("Resumo por Terapeuta", "FinanceiroMassagens", "Relatorio", new { area = "" }, null)</li>
                                        <li>@Html.ActionLink("Massagens Mais Pedidas", "MassagensMaisPedidas", "Relatorio", new { area = "" }, null)</li>
                                        <li>@Html.ActionLink("Horários das Terapeutas", "GerarRelatorioHorariosAtendimento", "Relatorio", new { area = "" }, null)</li>
                                        <li>@Html.ActionLink("Horários do Dia", "DisponibilidadeDeTerapeutas", "Relatorio", new { area = "" }, null)</li>
                                        <li>@Html.ActionLink("Tabela de Preços", "GerarTabelaDePrecos", "Relatorio", new { area = "" }, null)</li>

                                        @*<li>Relatório Financeiro Administrativo</li>*@
                                    </ul>
                                </li>
                            }
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">Sobre <span class="caret"></span></a>
                                <ul class="dropdown-menu" role="menu">
                                    @*<li>@Html.ActionLink("Tarefas", "Index", "Tasks", new { area = "" }, null)</li>*@
                                    <li>@Html.ActionLink("Contato", "Create", "FaleConosco", new { area = "" }, null)</li>
                                    <li>@Html.ActionLink("Mensagens do Dia", "Index", "Chat", new { area = "" }, null)</li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li>@Html.ActionLink("Agendar Agora", "Create", "Agendamento", new { area = "" }, null)</li>

                            <li>@Html.ActionLink("Tabela de Preços", "GerarTabelaDePrecos", "Relatorio", new { area = "" }, null)</li>

                            <li>@Html.ActionLink("Disponibilidade", "DisponibilidadeDeTerapeutas", "Relatorio", new { area = "" }, null)</li>
                        }
                        <li style="margin-left: 40px;">
                            @Html.Partial("_LoginPartial")
                        </li>

                        <li style="margin-left: 40px;"><a href="http://webmail.corpuspa.com.br">Webmail</a></li>
                        @*<li>@Html.ActionLink("API", "Index", "Help", new { area = "" }, null)</li>*@
                    </ul>
                </div>
            </div>
        </div>
    </header>


    <div class="container body-content">

        <div id="avm-logo" style="float:right;width:143px;height:59px;opacity:0.3;margin-right:60px;">
            &nbsp;
            @*<img width="143" height="59" src="https://avmsistemasinfo.files.wordpress.com/2014/08/logo.png" alt="AVM Sistemas"><br />*@
            @*<img src="~/Content/images/corpuspa-brand.png" alt="Corpus SPA" /><br />*@
        </div>

        @RenderBody()
        <hr />
    </div>

    <footer style="position:fixed;bottom:0;margin-left:0;width:100%;background-color:#2c3e68;color:#fff;height:20px;" id="avmfooter">
        <p style="margin-left:4px;">&copy; @DateTime.Now.Year - <a href="http://www.avmsistemas.net">AVM Sistemas</a> - [ON: @HttpContext.Current.Application["UsersOnline"]]</span></p>
    </footer>

    @*@Scripts.Render("~/bundles/globalize")*@
    @Scripts.Render("~/bundles/jquerymaskedinput")
    @Styles.Render("~/Content/jqueryui")

    @RenderSection("scripts", required: false)
    <script type="javascript">
        $(document).ready(function () {
          Globalize.culture("pt-BR");
        });
    </script>

</body>
</html>
