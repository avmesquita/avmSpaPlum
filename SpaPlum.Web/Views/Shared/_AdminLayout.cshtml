									<li style="display:block;width:100%;text-align:left;">@Html.ActionLink("Tabela de Preços", "GerarTabelaDePrecos", "Relatorio", new { style = "font-family:monospace;font-size:16px;" })</li>
									<li style="display:block;width:100%;text-align:left;">@Html.ActionLink("Disponibilidade", "DisponibilidadeDeTerapeutas", "Relatorio", new { area = "" }, new { style = "font-family:monospace;font-size:16px;" })</li>
									<li style="display:block;width:100%;text-align:left;">&nbsp;</li>
									@Html.Partial("_LoginPartialCompromise")
								</ul>
							</li>
						</ul>
					}
				}
				else
				{
					<ul style="list-style-type: none;margin: 0;padding: 0;overflow: hidden;">
						<li>
							<h2 style="font-family:fantasy;font-size:30px;">Menu de Acesso</h2>
							<ul style="padding-top:20px;">
								@Html.Partial("_LoginPartialCompromise")
							</ul>
						</li>
					</ul>
				}
			</div>
			<div class="col-md-9" id="avm-body" style="padding-top:20px;">
				@RenderBody()
			</div>
		</div>
		<div class="row" id="avm-footer" style="background-color:#2F4F4F;height:21px;">
			<p style="color:white;margin-left:4px;text-decoration:none;">&copy; @DateTime.Now.Year - <a href="http://www.avmsistemas.net" style="text-decoration:none;color:white;">AVM Sistemas</a> - [ON: @HttpContext.Current.Application["UsersOnline"]]</p>
		</div>
	</div>

	@Scripts.Render("~/bundles/globalize")
	@Scripts.Render("~/bundles/jquerymaskedinput")
	@Styles.Render("~/Content/jqueryui")
	@RenderSection("scripts", required: false)
	<script type="javascript">
		$(document).ready(function () {
		  Globalize.culture("pt-BR");
		});
	</script>
</body>
</html>
