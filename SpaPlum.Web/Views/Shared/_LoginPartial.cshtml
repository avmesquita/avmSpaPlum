@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
    {
    @Html.AntiForgeryToken()

    <ul class="nav navbar-nav navbar-right">
        <li style="display:inline;">
            @{                
                var nome = SpaPlum.Web.Models.UserExtendedModel.GetNome(HttpContext.Current.User); //new SpaPlum.Web.Controllers.AccountController().getClaimNome();
                var email = User.Identity.GetUserName();
                var display = (!string.IsNullOrEmpty(nome) ? nome : email);
            }

            @Html.ActionLink("Olá, " + display + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Manage" })
        </li>
        <li style="display:inline;"><a href="javascript:document.getElementById('logoutForm').submit()">Sair</a></li>
    </ul>
    }
}
else
{
    <ul class="nav navbar-nav navbar-right">
        <li style="display:inline;">@Html.ActionLink("Novo", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>
        <li style="display:inline;">@Html.ActionLink("Entrar", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })</li>
    </ul>
}
