@model SpaPlum.Web.Entity.Servico

@{
    ViewBag.Title = "Cadastro de Serviços";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:10px;" })
</div>

<div class="col-md-8">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
			<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Cadastro de Serviço</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="col-md-8">

                <div class="form-group">
                    @Html.LabelFor(model => model.Nome, htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Nome, new { htmlAttributes = new { @class = "form-control", @placeholder = "Informe aqui a descrição" } })
                        @Html.ValidationMessageFor(model => model.Nome, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.CodigoFilial, "Filial", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.DropDownList("CodigoFilial", new SelectList(ViewBag.ListaFilial, "Value", "Text"), new { htmlAttributes = new { @class = "form-control" }, style = "width:435px;height:33px;" })
                        @Html.ValidationMessageFor(model => model.CodigoFilial, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.TempoAproximadoDoServico, "Duração (minutos)", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.TempoAproximadoDoServico, new { htmlAttributes = new { @class = "form-control", placeholder = "Informe a duração em minutos" } })
                        @Html.ValidationMessageFor(model => model.TempoAproximadoDoServico, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.Ativo, "Ativo", htmlAttributes: new { @class = "control-label col-md-3" })
                    <div class="col-md-8">
                        @Html.EditorFor(model => model.Ativo, new { htmlAttributes = new { @class = "form-control", style = "text-align:left;width:30px;" } })
                        @Html.ValidationMessageFor(model => model.Ativo, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

            <div class="col-md-8">
                <fieldset>
                    <legend>Valor Normal</legend>
                    <div class="form-group">
                        @Html.LabelFor(model => model.Valor, htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.Valor, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Valor, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ValorComissaoEmpresa, "Empresa", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.ValorComissaoEmpresa, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ValorComissaoEmpresa, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.ValorComissaoTerapeuta, "Terapeuta", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-8">
                            @Html.EditorFor(model => model.ValorComissaoTerapeuta, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ValorComissaoTerapeuta, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </fieldset>


                <fieldset>
                    <legend>Valores Promocionais</legend>

                    <div class="form-group">
                        @Html.LabelFor(model => model.EmPromocao, "Promoção", htmlAttributes: new { @class = "control-label col-md-3" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.EmPromocao, new { htmlAttributes = new { @class = "form-control", style = "text-align:left;width:30px;" } })
                            @Html.ValidationMessageFor(model => model.EmPromocao, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    @{ string truque = "display:none;";}
                    @if (Model != null && Convert.ToBoolean(Model.EmPromocao))
                    {
                        truque = "";
                    }
                    <div id="dados-promocao" style="@truque">
                        <div class="form-group">
                            @Html.LabelFor(model => model.ValorPromocao, "Valor", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.ValorPromocao, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ValorPromocao, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ValorPromocaoComissaoEmpresa, "Empresa", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.ValorPromocaoComissaoEmpresa, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ValorPromocaoComissaoEmpresa, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.LabelFor(model => model.ValorPromocaoComissaoTerapeuta, "Terapeuta", htmlAttributes: new { @class = "control-label col-md-3" })
                            <div class="col-md-8">
                                @Html.EditorFor(model => model.ValorPromocaoComissaoTerapeuta, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ValorPromocaoComissaoTerapeuta, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>

            <div class="form-group" style="padding-top:30px;text-align:center;">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Gravar" class="btn btn-default btn-primary btn-success" />&nbsp;&nbsp;@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-info", title = "Voltar" })
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {

    <script language="javascript">

                            $(document).ready(function () {
                                $('#Valor').val(0);
                                $('#ValorComissaoEmpresa').val(0);
                                $('#ValorComissaoTerapeuta').val(0);
                                $('#ValorPromocao').val(0);
                                $('#ValorPromocaoComissaoEmpresa').val(0);
                                $('#ValorPromocaoComissaoTerapeuta').val(0);
                                $('#TempoAproximadoDoServico').val(60);

                                $('#EmPromocao').click(function () {
                                    var e = document.getElementById("EmPromocao");
                                    if (e != null) {
                                        if (e.checked) {
                                            $('#dados-promocao').show();
                                        } else {
                                            $('#dados-promocao').hide();
                                        }
                                    }
                                });
                            });

                            $.validator.methods.range = function (value, element, param) {
                                var globalizedValue = value.replace(",", ".");
                                return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
                            }

                            $.validator.methods.number = function (value, element) {
                                return this.optional(element) || /-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
                            }
    </script>
}
