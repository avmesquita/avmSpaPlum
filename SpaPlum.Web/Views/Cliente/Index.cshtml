@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.Cliente>

@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão de Clientes</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Cadastrar Novo Cliente" })
</div>
<div class="container">
	<table id="tabela-clientes" class="table table-hover">
		<thead>
			<tr>
				<th></th>
				<th>Nome</th>
				<th>E-mail</th>
				<th>Telefone</th>
				<th>VIP</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@*@Html.ActionLink(" ", "Edit", new { id = item.CodigoCliente }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })*@
						@Html.ActionLink(" ", "Details", new { id = item.CodigoCliente }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })
						@*@Html.ActionLink(" ", "Delete", new { id = item.CodigoCliente }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })*@
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Nome)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Email)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Telefone)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.PontosVIP)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Ativo)
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>