@model SpaPlum.Web.Entity.Agendamento

@{
    ViewBag.Title = "Sucesso no Agendamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Corpus SPA</h2>


<br />
<img src="~/Content/images/icon-success.png" width="50" height="50" alt="sucesso" />
<h4>O agendamento foi concluído com sucesso.</h4>
<h6>Nossa Central entrará em contato em breve.</h6>
<hr />

@if (!HttpContext.Current.Request.Browser.IsMobileDevice)
{
<img class="" src="@Url.Action("Generate", "Agendamento", new { texto = Model.Autenticacao })" alt="SpaPlum Corpus SPA QRCode" style="position:absolute;background:#fff;margin-left:660px;zoom:70%;" />
}

<dl class="dl-horizontal">
    <dt>Local</dt>
    <dd>@Html.DisplayFor(modelItem => new SpaPlum.Web.Contexto.AgendamentoContexto().FilialModels.Find(Model.CodigoFilial).Nome)</dd>

    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>

    <dt>Forma de Pagamento</dt>
    <dd>@Html.DisplayFor(modelItem => new SpaPlum.Web.Contexto.AgendamentoContexto().TipoPagamentoModels.Find(Model.CodigoTipoPagamento).Descricao)</dd>

    <dt>Valor</dt>
    <dd>@Html.DisplayFor(model => model.Valor)</dd>

    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>

    <dt>Nome do Cliente</dt>
    <dd>@Html.DisplayFor(model => model.NomeCliente)</dd>

    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>

    <dt>Data Inicial</dt>
    <dd>@Html.DisplayFor(model => model.DataInicial)</dd>

    <dt>Data Final</dt>
    <dd>@Html.DisplayFor(model => model.DataFinal)</dd>

    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>

    <dt>Autenticação</dt>
    <dd>@Html.DisplayFor(model => model.Autenticacao)</dd>

    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>
</dl>

<div class="">
    <table class="table" style="zoom:80%; width:60%">
        <tr>
            <th>Terapia</th>
            <th>Tipo</th>
            <th style="text-align:center;">Períodos</th>
            <th>Terapeuta</th>
            <th style="text-align:right;">Valor Unit.</th>
            <th style="text-align:right;">Valor Total</th>
        </tr>

        @foreach (var item in Model.ItensDoAgendamento)
        {

            var servico = new SpaPlum.Web.Contexto.AgendamentoContexto().ServicoModels.Find(item.CodigoServico).Nome;
            var terapeuta = new SpaPlum.Web.Contexto.AgendamentoContexto().TerapeutaModels.Find(item.CodigoTerapeuta).Nome;
            var tipo = new SpaPlum.Web.Helpers.ListaTipoDeMassagem().Lista.Where(x => x.Value.Equals(item.TipoDeMassagem.ToString())).FirstOrDefault().Text;
            var fator = 1;
            if (item.TipoDeMassagem > 0)
            {
                fator = 2;
            }

            <tr>
                <td>@servico</td>
                <td>@tipo</td>
                <td style="text-align:center;">@item.QtdePeriodos</td>
                <td>@terapeuta</td>
                <td style="text-align:right;">@item.Valor</td>
                <td style="text-align:right;">@(item.Valor * item.QtdePeriodos * fator)</td>
            </tr>
        }
        <tr>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td>&nbsp;</td>
            <td style="text-align:right;">@Html.DisplayFor(model => model.Valor)</td>
        </tr>

    </table>
</div>

<dl class="dl-horizontal">
    <dt>&nbsp;</dt>
    <dd>&nbsp;</dd>
</dl>

@if (HttpContext.Current.Request.Browser.IsMobileDevice)
{
    <img class="" src="@Url.Action("Generate", "Agendamento", new { texto = Model.Autenticacao })" alt="SpaPlum Corpus SPA QRCode" style="background:#fff;zoom:70%;" />
}


<div class="clearfix"></div>
<p>
    @Html.ActionLink(" ", "Create", "Agendamento", new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Novo Agendamento" })
</p>
