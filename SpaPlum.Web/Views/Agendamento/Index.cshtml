@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.Agendamento>

@{
	ViewBag.Title = "Agendamento";
	//Layout = "~/Views/Shared/_Layout.cshtml";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
	decimal valorTotal = decimal.Zero;
}

<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão da Agenda</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Agendar" })
</div>
<div class="container">
	<table id="tabela-agendamentos" class="table table-hover" style="zoom:80%;">
		<thead>
			<tr>
				<th></th>
				<th>
					Filial
				</th>
				<th>
					Início
				</th>
				<th>
					Fim
				</th>
				<th colspan="4">
					Itens do Agendamento
				</th>
				<th>
					Cliente
				</th>
				<th>
					Valor
				</th>
				<th>
					Status
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Edit", new { id = item.CodigoAgendamento }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })
						@Html.ActionLink(" ", "Details", new { id = item.CodigoAgendamento }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })
						@Html.ActionLink(" ", "Cancelar", new { id = item.CodigoAgendamento }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Cancelar Agendamento" })
						@Html.ActionLink(" ", "Pago", new { id = item.CodigoAgendamento }, new { @class = "btn btn-primary btn-large btn-success glyphicon glyphicon-usd", title = "Sinalizar Pagamento" })
					</td>
					<td style="vertical-align:middle;">
						@* @Html.DisplayFor(modelItem => item.Filial.Nome) *@
						@Html.Raw(new SpaPlum.Web.Contexto.AgendamentoContexto().FilialModels.Find(item.CodigoFilial).Nome)
					</td>
					<td style="vertical-align:middle;">
						@Html.DisplayFor(modelItem => item.DataInicial)
					</td>
					<td style="vertical-align:middle;">
						@string.Format("{0:HH:mm:ss}", item.DataFinal)
					</td>

					<td colspan="4">
						<table class="table-condensed" style="zoom:80%;">
							<tr>
								<th>Serviço</th>
								<th>Tipo</th>
								<th>Periodos</th>
								<th>Terapeuta</th>
							</tr>
							@foreach (var itemAgendamento in item.ItensDoAgendamento)
							{
								var servico = new SpaPlum.Web.Contexto.AgendamentoContexto().ServicoModels.Find(itemAgendamento.CodigoServico).Nome;
								var terapeuta = new SpaPlum.Web.Contexto.AgendamentoContexto().TerapeutaModels.Find(itemAgendamento.CodigoTerapeuta).Nome;
								var tipo = new SpaPlum.Web.Helpers.ListaTipoDeMassagem().Lista.Where(x => x.Value.Equals(itemAgendamento.TipoDeMassagem.ToString())).FirstOrDefault().Text;
								<tr>
									<td>@servico</td>
									<td>@tipo</td>
									<td style="text-align:center;">@itemAgendamento.QtdePeriodos</td>
									<td>@terapeuta</td>
								</tr>

							}
						</table>
					</td>

					<td style="vertical-align:middle;">
						@Html.DisplayFor(modelItem => item.NomeCliente)
					</td>
					<td style="vertical-align:middle;">
						@Html.DisplayFor(modelItem => item.Valor)

						@{ valorTotal = valorTotal + (Convert.ToDecimal(item.Valor)); }
					</td>
					<td style="vertical-align:middle;">
						@*Enum.GetName(typeof(SpaPlum.Web.Entity.StatusAgendamento), item.CodigoStatusAgendamento)                *@
						@(new SpaPlum.Web.Helpers.ListaStatusAgendamento().StatusAgendamentoListItem.Where(x => x.Value.Equals(item.CodigoStatusAgendamento.ToString())).FirstOrDefault().Text)
					</td>
				</tr>
			}
		</tbody>
		<tfoot>
			<tr>
				<td></td>
				<td></td>
				<td></td>
				<td></td>
				<td colspan="4"></td>
				<td></td>
				<td style="vertical-align:middle;">
					@(valorTotal > 0 ? valorTotal.ToString() : "")
				</td>
				<td></td>
			</tr>
		</tfoot>
	</table>
	@*
			@if (Model.HasNextPage || Model.HasPreviousPage)
			{
		<div style="text-align: center">
			@Html.PagedListPager(Model, (page) => Url.Action("Index", new { page = page }), PagedListRenderOptions.Classic)
		</div>
			}
	*@
</div>