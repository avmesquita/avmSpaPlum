@{
    ViewBag.Title = "Agendamento em 5 passos";
    Layout = "~/Views/Shared/_LayoutWizard.cshtml";
}

<div class="form-horizontal">
    <h3>Agendamento em 5 passos</h3>
    <hr />
    <div class="row" style="font-family:'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;font-size:20px;">

        <p><span class="glyphicon glyphicon-home"></span>&nbsp;&nbsp;Selecione o local<br /><br /></p>
        <p><span class="glyphicon glyphicon-calendar"></span>&nbsp;&nbsp;Selecione a data<br /><br /></p>
        <p><span class="glyphicon glyphicon-user"></span>&nbsp;&nbsp;Selecione quem faz o que<br /><br /></p>
        <p><span class="glyphicon glyphicon-usd"></span>&nbsp;&nbsp;Valores e Pagamentos<br /><br /></p>
        <p><span class="glyphicon glyphicon-heart"></span>&nbsp;&nbsp;Conte-nos sobre você<br /><br /></p>

    </div>
    <br />
    <div class="row">
        <input type="submit" value="PASSO 1" class="btn btn-default btn-success" id="btnAgendar" name="btnAgendar" style="height:40px;width:300px;" />
    </div>
</div>

