@model SpaPlum.Web.Entity.Agendamento

@{
    ViewBag.Title = "Exclusão de Agendamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Corpus SPA</h2>

<div style="float:right;width:150px;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:10px;" })
</div>

<h3>Tem certeza que deseja excluir?</h3>
<div>
    <h4>Agendamento</h4>
    <hr />
    <div class="col-md-6">
        <dl class="dl-horizontal">
            <dt>Local</dt>
            <dd>@Html.DisplayFor(modelItem => new SpaPlum.Web.Contexto.AgendamentoContexto().FilialModels.Find(Model.CodigoFilial).Nome)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Data Inicial</dt>
            <dd>@Html.DisplayFor(model => model.DataInicial)</dd>

            <dt>Data Final</dt>
            <dd>@Html.DisplayFor(model => model.DataFinal)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Forma de Pagamento</dt>
            <dd>@Html.DisplayFor(modelItem => new SpaPlum.Web.Contexto.AgendamentoContexto().TipoPagamentoModels.Find(Model.CodigoTipoPagamento).Descricao)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Valor</dt>
            <dd>@Html.DisplayFor(model => model.Valor)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Taxa Adicional</dt>
            <dd>@Html.DisplayFor(model => model.ValorTaxaAdicional)</dd>

            <dt>Taxa Pagto</dt>
            <dd>@Html.DisplayFor(model => model.ValorTaxaFormaPagto)</dd>

            <dt>Mora Pagto</dt>
            <dd>@Html.DisplayFor(model => model.ValorMoraFormaPagto)</dd>
        </dl>
    </div>
    <div class="col-md-6">
        @{
            decimal valorComissaoEmpresa = 0;
            decimal valorComissaoTerapeuta = 0;
            foreach (var item in Model.ItensDoAgendamento)
            {
                var fator = 1;
                if (item.TipoDeMassagem > 0)
                {
                    fator = 2;
                }
                valorComissaoEmpresa += ((Convert.ToDecimal(item.ValorComissaoEmpresa) * fator * item.QtdePeriodos)
                                         - Convert.ToDecimal(item.ValorTaxaProRata)
                                         - Convert.ToDecimal(item.ValorMoraProRata));

                valorComissaoTerapeuta += item.ValorComissaoTerapeuta * fator * item.QtdePeriodos;
            }
        }
        <dl class="dl-horizontal">
            <dt>Valor Empresa</dt>
            <dd>R$@valorComissaoEmpresa</dd>

            <dt>Valor Terapeuta</dt>
            <dd>R$@valorComissaoTerapeuta</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Nome do Cliente</dt>
            <dd>@Html.DisplayFor(model => model.NomeCliente)</dd>

            <dt>E-Mail</dt>
            <dd>@Html.DisplayFor(model => model.EmailDoCliente)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Observação</dt>
            <dd>@Html.DisplayFor(model => model.Observacao)</dd>

            <dt>&nbsp;</dt>
            <dd>&nbsp;</dd>

            <dt>Autenticação</dt>
            <dd>@Html.DisplayFor(model => model.Autenticacao)</dd>

            <dt>Session ID</dt>
            <dd>@Html.DisplayFor(model => model.SessionID)</dd>

            <dt>IP do Cliente</dt>
            <dd>@Html.DisplayFor(model => model.IPdoCliente)</dd>

            @*
                <dt>Token do Paypal</dt>
                <dd>@Html.DisplayFor(model => model.TokenPayPal)</dd>
            *@
        </dl>
    </div>
    <br /><br />
    <div class="clearfix"></div>
    <div class="col-md-12">
        <center>
            <table class="table" style="zoom:80%; width:60%">
                <tr>
                    <th>Terapia</th>
                    <th>Tipo</th>
                    <th style="text-align:center;">Períodos</th>
                    <th>Terapeuta</th>
                    <th style="text-align:right;">Valor Unit.</th>
                    <th style="text-align:right;">Valor Total</th>
                </tr>

                @foreach (var item in Model.ItensDoAgendamento)
            {

                var servico = new SpaPlum.Web.Contexto.AgendamentoContexto().ServicoModels.Find(item.CodigoServico).Nome;
                var terapeuta = new SpaPlum.Web.Contexto.AgendamentoContexto().TerapeutaModels.Find(item.CodigoTerapeuta).Nome;
                var tipo = new SpaPlum.Web.Helpers.ListaTipoDeMassagem().Lista.Where(x => x.Value.Equals(item.TipoDeMassagem.ToString())).FirstOrDefault().Text;
                var fator = 1;
                if (item.TipoDeMassagem > 0)
                {
                    fator = 2;
                }

                <tr>
                    <td>@servico</td>
                    <td>@tipo</td>
                    <td style="text-align:center;">@item.QtdePeriodos</td>
                    <td>@terapeuta</td>
                    <td style="text-align:right;">@item.Valor</td>
                    <td style="text-align:right;">@(item.Valor * item.QtdePeriodos * fator)</td>
                </tr>}
                <tr>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td>&nbsp;</td>
                    <td style="text-align:right;">@Html.DisplayFor(model => model.Valor)</td>
                </tr>

            </table>
        </center>
    </div>

    <dl class="dl-horizontal">
        <dt>&nbsp;</dt>
        <dd>&nbsp;</dd>
    </dl>

</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-actions no-color">
        <center>
            <table>
                <tr>
                    <td><input type="submit" value="Excluir" class="btn btn-default btn-danger" /></td>
                    <td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td>
                    <td>@Html.ActionLink("Desistir", "Index", null, new { @class = "btn btn-default btn-info" })</td>
                </tr>
            </table>
        </center>
    </div>
}

