@model SpaPlum.Web.Entity.TipoPagamento

@{
    ViewBag.Title = "Detalhes da Forma de Pagto";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:10px;" })
</div>

<div class="col-md-8">
    <div>
		<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Detalhes da Forma de Pagamento</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.CodigoFilial)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @Html.DisplayFor(model => model.Filial.Nome)
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.Descricao)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @Html.DisplayFor(model => model.Descricao)
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.Taxa)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @Html.DisplayFor(model => model.Taxa)
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.TipoTaxa)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @if (Model.TipoTaxa == "R")
                {
                    @Html.Raw("Real")
                }
                else
                {
                    @Html.Raw("Percentual")
                }
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.Mora)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @Html.DisplayFor(model => model.Mora)
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.TipoMora)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @if (Model.TipoMora == "R")
                {
                    @Html.Raw("Real")
                }
                else
                {
                    @Html.Raw("Percentual")
                }
            </dd>

            <dt style="font-size:16px;line-height:30px;">
                @Html.DisplayNameFor(model => model.Ativo)
            </dt>

            <dd style="font-size:16px;line-height:30px;">
                @Html.DisplayFor(model => model.Ativo)
            </dd>



        </dl>
    </div>
    <p style="padding-top:30px;text-align:center;">
        @Html.ActionLink(" ", "Edit", new { id = Model.CodigoTipoPagamento }, new { @class = "btn btn-success btn-large glyphicon glyphicon-pencil", title = "Editar" })&nbsp;&nbsp;@Html.ActionLink("Voltar", "Index", null, new { @class = "btn btn-default btn-info", title = "Voltar" })
    </p>
</div>