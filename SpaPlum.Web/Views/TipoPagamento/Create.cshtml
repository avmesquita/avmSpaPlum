@model SpaPlum.Web.Entity.TipoPagamento

@{
    ViewBag.Title = "Cadastro de Formas de Pagamento";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:10px;" })
</div>

<div class="col-md-8">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-horizontal">
			<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Formas de Pagamento</h4>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })


            <div class="form-group">
                @Html.LabelFor(model => model.CodigoFilial, "Filial", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("CodigoFilial", new SelectList(ViewBag.ListaFilial, "Value", "Text"), new { htmlAttributes = new { @class = "form-control" }, style = "width:500px;height:33px;" })
                    @Html.ValidationMessageFor(model => model.CodigoFilial, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Descricao, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Descricao, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Descricao, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Taxa, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Taxa, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Taxa, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Tipo Taxa", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="radio-inline">
                        @Html.RadioButtonFor(model => model.TipoTaxa, "R", new { htmlAttributes = new { @class = "form-control radio-inline", name = "rbTipoTaxaR" } })
                        <span class="fa fa-usd"></span>&nbsp;Valor Real
                    </div>
                    <div class="radio-inline">
                        @Html.RadioButtonFor(model => model.TipoTaxa, "P", new { htmlAttributes = new { @class = "form-control radio-inline", name = "rbTipoTaxaR" } })
                        <span class="fa fa-percent"></span>&nbsp;Valor Percentual
                    </div>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Mora, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Mora, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Mora, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Tipo Mora", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    <div class="radio-inline">
                        @Html.RadioButtonFor(model => model.TipoMora, "R", new { htmlAttributes = new { @class = "form-control radio-inline", name = "rbTipoMoraR" } })
                        <span class="fa fa-usd"></span>&nbsp;Valor Real
                    </div>
                    <div class="radio-inline">
                        @Html.RadioButtonFor(model => model.TipoMora, "P", new { htmlAttributes = new { @class = "form-control radio-inline", name = "rbTipoMoraR" } })
                        <span class="fa fa-percent"></span>&nbsp;Valor Percentual
                    </div>
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Ativo, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Ativo, new { htmlAttributes = new { @class = "form-control", style = "text-align:left;width:30px;" } })
                    @Html.ValidationMessageFor(model => model.Ativo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group" style="display:none;">
                @Html.Label("Processa Online", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.GatewayAtivo, new { htmlAttributes = new { @class = "form-control", style = "text-align:left;width:30px;", @disabled = "disabled" } })
                    @Html.ValidationMessageFor(model => model.GatewayAtivo, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group" style="display:none;">
                @Html.Label("Gateway", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownList("CodigoGatewayPagamento", new SelectList(ViewBag.ListaGatewayPagamento, "Value", "Text"), "Selecione o Gateway...", new { htmlAttributes = new { @class = "form-control" }, style = "width:600px;height:33px;", @disabled = "disabled" })
                    @Html.ValidationMessageFor(model => model.CodigoGatewayPagamento, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Gravar" class="btn btn-default btn-primary" />
                </div>
            </div>
        </div>
    }
</div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
        @Scripts.Render("~/bundles/bootstrap")

        <script type="text/javascript">
            $(document).ready(function () {

                $("#Taxa").val('0,00');
                $("#Mora").val('0,00');

                $.validator.methods.range = function (value, element, param) {
                    //var globalizedValue = value.replace(",", ".");
                    //return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
                    //Use the Globalization plugin to parse the value
                    var val = $.global.parseFloat(value);
                    return this.optional(element) || (val >= param[0] && val <= param[1]);
                }

                $.validator.methods.number = function (value, element) {
                    return this.optional(element) || /-?(?:\d+|\d{1,3}(?:[\s\.,]\d{3})+)(?:[\.,]\d+)?$/.test(value);
                }

                $.validator.methods.date = function (value, element) {
                    return true; /*this.optional(element) || /^\d\d?\/\d\d?\/\d\d\d?\d?$/.test(value);*/
                };
            });

        </script>



    }
