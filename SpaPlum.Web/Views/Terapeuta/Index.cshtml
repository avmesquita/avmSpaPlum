@using PagedList;
@using PagedList.Mvc;
@model IPagedList<SpaPlum.Web.Entity.Terapeuta>

@{
	ViewBag.Title = "Cadastro de Profissionais";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão de Profissionais</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success fas fa-plus", title = "Cadastrar Novo Profissional" })
</div>
<div class="container">
	<table id="tabela-terapeutas" class="table table-hover">
		<thead>
			<tr>
				<th></th>
				<th>
					Filial
				</th>
				@*
					<th>
						Código Interno
					</th>
				*@
				<th>
					Nome
				</th>
				<th>
					Ativo
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Edit", new { id = item.CodigoTerapeuta }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })
						@Html.ActionLink(" ", "Details", new { id = item.CodigoTerapeuta }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })

						@{
							//var k = new SpaPlum.Web.Contexto.AgendamentoContexto().AgendamentoModels.AsNoTracking().Where(x => x.CodigoTerapeuta == item.CodigoTerapeuta).Count();
							//if (k == 0)
							//{
							@Html.ActionLink(" ", "Delete", new { id = item.CodigoTerapeuta }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
							//}


						}
					</td>
					<td>
						@Html.DisplayFor(modelItem => new SpaPlum.Web.Contexto.AgendamentoContexto().FilialModels.Find(item.CodigoFilial).Nome)
					</td>
					@*
						<td>
							@Html.DisplayFor(modelItem => item.CodigoTerapeuta)
						</td>
					*@
					<td>
						@Html.DisplayFor(modelItem => item.Nome)
					</td>
					<td>
						@if (item.Ativa)
						{
							@Html.Raw("Sim")
						}
						else
						{
							@Html.Raw("Não")
						}
					</td>

				</tr>
			}
		</tbody>
	</table>
</div>
@*
	<div style="text-align: center">
		@Html.PagedListPager(Model, (page) => Url.Action("Index", new { page = page }), PagedListRenderOptions.Classic)
	</div>
*@
