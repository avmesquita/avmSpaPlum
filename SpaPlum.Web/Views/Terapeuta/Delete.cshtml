@model SpaPlum.Web.Entity.Terapeuta

@{
    ViewBag.Title = "Exclusão de Profissional";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div style="float:right;width:150px;display:none;">
    @Html.ActionLink(" ", "Index", null, new { @class = "btn btn-default btn-warning glyphicon glyphicon-arrow-left", title = "Voltar", style = "margin-top:30px;" })
</div>

<div class="col-md-8">
    <h3 style="color:red;text-align:center;"><b>Tem certeza que deseja excluir?</b></h3>
    <br /><br />
    <div>
		<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Detalhes do Profissional</h4>
        <hr />
		<dl class="dl-horizontal">
			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.Nome)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.Nome)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.EMail)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.EMail)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.Telefone)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.Telefone)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.Ativa)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.Ativa)
			</dd>

			<dt style="font-size:16px;line-height:30px;">
				@Html.DisplayNameFor(model => model.DataCadastro)
			</dt>

			<dd style="font-size:16px;line-height:30px;">
				@Html.DisplayFor(model => model.DataCadastro)
			</dd>

		</dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color" style="padding-top:30px;text-align:center;">
                <input type="submit" value="Excluir" class="btn btn-default btn-primary btn-danger" />&nbsp;&nbsp;@Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-default btn-error", title = "Voltar" })
            </div>
        }
    </div>
</div>