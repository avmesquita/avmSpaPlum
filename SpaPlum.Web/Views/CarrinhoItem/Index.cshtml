            @Html.DisplayFor(modelItem => item.Servico.Nome)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Terapeuta.Nome)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.CodigoCarrinho)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TipoDeMassagem)
