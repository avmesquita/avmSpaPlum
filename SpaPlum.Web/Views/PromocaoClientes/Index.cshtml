@model IEnumerable<SpaPlum.Web.Entity.PromocaoCliente>

@{
	ViewBag.Title = "Index";
	Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Scripts {
	@Scripts.Render("~/bundles/jqueryval")
	@Scripts.Render("~/bundles/bootstrap")
	@Scripts.Render("~/bundles/datatables")
	@Styles.Render("~/Content/datatables")

	<script type="text/javascript">
		$(document).ready(function () {

			$('#tabela-promocoes-clientes').DataTable({
				"language": { "url": "//cdn.datatables.net/plug-ins/1.10.16/i18n/Portuguese-Brasil.json" }
			});

		});
	</script>
}
<h4 style="text-decoration:none;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-size:24px;padding-left:20px;">Gestão de Promoção/Cliente</h4>
<br />
<div style="float:right;padding-bottom:10px;padding-right:15px;">
	@Html.ActionLink(" ", "Create", null, new { @class = "btn btn-primary btn-large btn-success glyphicon glyphicon-plus-sign", title = "Vincular Promoção à Cliente" })
</div>
<div class="col-md-12">
	<table id="tabela-promocoes-clientes" class="table">
		<thead>
			<tr>
				<th></th>
				<th>
					Nome da Promoção
				</th>
				<th>
					Motivo
				</th>
				<th>
					Cliente Beneficiário
				</th>
				<th>
					Qtde Max Utilizacão
				</th>
				<th>
					Ultima Utilizacao
				</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
					<td>
						@Html.ActionLink(" ", "Edit", new { id = item.CodigoPromocaoCliente }, new { @class = "btn btn-warning btn-large glyphicon glyphicon-pencil", title = "Editar" })
						@Html.ActionLink(" ", "Details", new { id = item.CodigoPromocaoCliente }, new { @class = "btn btn-primary btn-large glyphicon glyphicon-list-alt", title = "Detalhes" })
						@Html.ActionLink(" ", "Delete", new { id = item.CodigoPromocaoCliente }, new { @class = "btn btn-large btn-danger glyphicon glyphicon-trash", title = "Excluir" })
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Promocao.Nome)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.Motivacao)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.ContaBeneficiaria)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.QuantidadeMaximaUtilizacoes)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.DataUltimaUtilizacao)
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>