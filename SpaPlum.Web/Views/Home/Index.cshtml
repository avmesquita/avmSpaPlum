@if (User.Identity.IsAuthenticated)
{
	<div class="col-md-8 pt-3">
		<h2 style="zoom:100%;"><i class="fa fa-snowflake-o" aria-hidden="true"></i>&nbsp;Rápido e Prático</h2>
		<p>
			<br />
			<input type="button" onclick="javascript:window.location='/Agendamento/Create'" value="CRIAR NOVO AGENDAMENTO" class="btn btn-default btn-success" />
		</p>
	</div>

}
@if (!User.Identity.IsAuthenticated)
{
	<div class="col-md-8 pt-3">
		<h2 style="zoom:100%;"><i class="fa fa-snowflake-o" aria-hidden="true"></i>&nbsp;Cadastre-se na plataforma de serviços Spa Plum!</h2>
		<p>
			<br />
			<input type="button" onclick="javascript:window.location='/Account/Register'" value="CADASTRE-SE" class="btn btn-default btn-info" />&nbsp;&nbsp;<input type="button" onclick="javascript:window.location='/Account/Login'" value="ENTRAR" class="btn btn-default" />
		</p>
	</div>
}
