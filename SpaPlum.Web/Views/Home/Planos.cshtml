
@{
    ViewBag.Title = "Planos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Planos</h2>

<div class="col-md-9" style="padding-top:40px;">
	<div class="table" style="width:100%;">
		<div class="col-md-3">
			<h2>Individual</h2>
			<p style="padding-top:40px;">Gestão de agendamento de serviços de apenas 1 CPF.</p>
			<p style="padding-top:25px;font-family:fantasy;font-size:24px;">R$ 50,00</p>
			<button class="btn btn-success btn-large">Assinar</button>
		</div>
		<div class="col-md-3">
			<h2>Empresa Pequena</h2>
			<p style="padding-top:40px;">Gestão de agendamentos de serviços de apenas uma filial.</p>
			<p style="padding-top:25px;font-family:fantasy;font-size:24px;">R$ 200,00</p>
			<button class="btn btn-success btn-large">Assinar</button>
		</div>
		<div class="col-md-3">
			<h2>Empresa Média</h2>
			<p style="padding-top:40px;">Gestão de agendamento de serviços até 5 filiais.</p>
			<p style="padding-top:25px;font-family:fantasy;font-size:24px;">R$ 900,00</p>
			<button class="btn btn-success btn-large">Assinar</button>
		</div>
		<div class="clearfix"></div>
	</div>
</div>