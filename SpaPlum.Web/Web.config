    <add key="SEGURANCA.FuncaoAdministrador" value="ramirezlavor@gmail.com, felipe.leonardo@globo.com, corpusparj@gmail.com, corpuspa@hotmail.com" />
    <add key="SEGURANCA.FuncaoCliente" value="avmesquita@gmail.com" />
